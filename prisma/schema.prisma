generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String
  email     String
  logo      String?
  createdAt DateTime @default(now())
}

model User {
  id                      String                @id @default(cuid())
  regId                   String                @unique
  name                    String
  email                   String                @unique
  phone                   String
  password                String
  role                    String
  avatar                  String?
  isActive                Boolean               @default(true)
  createdAt               DateTime              @default(now())
  installmentPlansCreated InstallmentPlan[]
  sentMessages            Message[]             @relation("SentMessages")
  createdConversations    MessageConversation[] @relation("CreatedConversations")
  messageParticipants     MessageParticipant[]
  notifications           Notification[]
  parent                  Parent?
  paymentsReceived        Payment[]
  student                 Student?
  teacher                 Teacher?
  notices                 Notice[]
  chatSessions            ChatSession[]
  aiTokenUsages           AITokenUsage[]
  auditLogs               AuditLog[]
}

model Student {
  id                   String             @id @default(cuid())
  studentCode          String?            @unique
  userId               String             @unique
  rollNo               String
  classId              String
  fatherName           String
  motherName           String
  fatherPhone          String
  motherPhone          String
  address              String
  gender               String?
  bloodGroup           String?
  dateOfBirth          DateTime
  admissionDate        DateTime
  parentId             String?
  isSuspended          Boolean            @default(false)
  suspendedReason      String?
  suspendedAt          DateTime?
  suspendedFrom        DateTime?
  suspendedUntil       DateTime?
  warningCount         Int                @default(0)
  lastWarningAt        DateTime?
  lastWarningNote      String?
  attendancePercentage Float              @default(100)
  examEligible         Boolean            @default(true)
  detainedAt           DateTime?
  detainedReason       String?
  detainedBy           String?
  hasTransport         Boolean            @default(false)
  transportZone        String?
  attendanceRecords    Attendance[]
  attendanceSummary    AttendanceSummary?
  creditWallet         CreditWallet?
  disciplineReports    DisciplineReport[]
  examResults          ExamResult[]
  examSummaries        ExamSummary[]
  feeRecords           FeeRecord[]
  hallTickets          HallTicket[]
  installmentPlans     InstallmentPlan[]
  payments             Payment[]
  submissions          Submission[]
  class                Class              @relation(fields: [classId], references: [id])
  parent               Parent?            @relation(fields: [parentId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([attendancePercentage])
}

model Parent {
  id         String    @id @default(cuid())
  parentCode String?   @unique
  userId     String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]
}

model Teacher {
  id                  String               @id @default(cuid())
  userId              String               @unique
  joinDate            DateTime
  salary              Float?
  classes             Class[]
  DailyAttendanceLog  DailyAttendanceLog[]
  reportedDisciplines DisciplineReport[]
  subjects            Subject[]
  assignments         Assignment[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetablePeriods    TimetablePeriod[]
}

model Class {
  id                 String               @id @default(cuid())
  name               String
  section            String
  teacherId          String
  assignments        Assignment[]
  teacher            Teacher              @relation(fields: [teacherId], references: [id])
  DailyAttendanceLog DailyAttendanceLog[]
  examSlots          ExamSlot[]
  students           Student[]
  subjects           Subject[]
  timetablePeriods   TimetablePeriod[]
  targetedNotices    Notice[]
}

model Subject {
  id               String            @id @default(cuid())
  name             String
  code             String
  classId          String
  teacherId        String
  assignments      Assignment[]
  examSlots        ExamSlot[]
  class            Class             @relation(fields: [classId], references: [id])
  teacher          Teacher           @relation(fields: [teacherId], references: [id])
  timetablePeriods TimetablePeriod[]
}

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  classId     String
  date        DateTime         @db.Date
  status      AttendanceStatus
  markedBy    String
  submittedAt DateTime         @default(now())
  headCount   Int?
  student     Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@index([studentId, date])
  @@index([studentId, status])
}

model AttendanceSummary {
  id                   String   @id @default(cuid())
  studentId            String   @unique
  totalClasses         Int      @default(0)
  presentCount         Int      @default(0)
  absentCount          Int      @default(0)
  lateCount            Int      @default(0)
  attendancePercentage Float    @default(100)
  lastUpdated          DateTime @default(now())
  student              Student  @relation(fields: [studentId], references: [id])
}

model DailyAttendanceLog {
  id            String   @id @default(cuid())
  classId       String
  teacherId     String
  date          DateTime @db.Date
  submittedAt   DateTime @default(now())
  totalStudents Int
  presentCount  Int
  absentCount   Int
  lateCount     Int      @default(0)
  blockedCount  Int      @default(0)
  headCount     Int
  class         Class    @relation(fields: [classId], references: [id])
  teacher       Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([classId, date])
}

model Assignment {
  id          String       @id @default(cuid())
  title       String
  description String
  subjectId   String
  classId     String
  teacherId   String
  dueDate     DateTime
  maxMarks    Float
  fileUrl     String?
  createdAt   DateTime     @default(now())
  class       Class        @relation(fields: [classId], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  submissions Submission[]

  @@index([teacherId])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  submittedAt  DateTime   @default(now())
  marks        Float?
  feedback     String?
  gradedAt     DateTime?
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Result {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  examType  String
  marks     Float
  maxMarks  Float
  grade     String
  remarks   String?
  createdAt DateTime @default(now())
}

model FeeRecord {
  id                 String            @id @default(cuid())
  invoiceId          String?           @unique
  studentId          String
  amount             Float
  feeType            String
  dueDate            DateTime
  paidDate           DateTime?
  status             String            @default("PENDING")
  receiptNo          String?
  paymentMode        String?
  paidAmount         Float             @default(0)
  hasInstallmentPlan Boolean           @default(false)
  installmentPlanId  String?
  lastPaymentAt      DateTime?
  student            Student                @relation(fields: [studentId], references: [id])
  installmentPlans   InstallmentPlan[]
  payments           Payment[]
  cashfreeOrders     CashfreePendingOrder[]

  @@index([studentId, status])
  @@index([dueDate, status])
}

model InstallmentPlan {
  id               String                @id @default(cuid())
  feeRecordId      String
  studentId        String
  createdByAdminId String
  totalMonths      Int
  status           String                @default("ACTIVE")
  createdAt        DateTime              @default(now())
  createdBy        User                  @relation(fields: [createdByAdminId], references: [id])
  feeRecord        FeeRecord             @relation(fields: [feeRecordId], references: [id])
  student          Student               @relation(fields: [studentId], references: [id])
  schedules        InstallmentSchedule[]
}

model InstallmentSchedule {
  id                String          @id @default(cuid())
  planId            String
  installmentNumber Int
  amount            Float
  dueDate           DateTime
  status            String          @default("PENDING")
  paidAt            DateTime?
  paymentId         String?
  plan              InstallmentPlan @relation(fields: [planId], references: [id])
  payments          Payment[]       @relation("SchedulePayments")
}

model Payment {
  id                    String               @id @default(cuid())
  studentId             String
  feeRecordId           String?
  installmentScheduleId String?
  amount                Float
  paymentMode           String
  transactionId         String?
  paymentDate           DateTime             @default(now())
  receivedByAdminId     String?
  receiptNumber         String               @unique
  note                  String?
  status                String               @default("SUCCESS")
  createdAt             DateTime             @default(now())
  feeRecord             FeeRecord?           @relation(fields: [feeRecordId], references: [id])
  installmentSchedule   InstallmentSchedule? @relation("SchedulePayments", fields: [installmentScheduleId], references: [id])
  receivedBy            User?                @relation(fields: [receivedByAdminId], references: [id])
  student               Student              @relation(fields: [studentId], references: [id])
}

model CreditWallet {
  id            String                    @id @default(cuid())
  studentId     String                    @unique
  balance       Float                     @default(0)
  lastUpdatedAt DateTime                  @default(now())
  student       Student                   @relation(fields: [studentId], references: [id])
  transactions  CreditWalletTransaction[]
}

model CreditWalletTransaction {
  id                 String       @id @default(cuid())
  walletId           String
  type               String
  amount             Float
  reason             String
  relatedFeeRecordId String?
  createdAt          DateTime     @default(now())
  wallet             CreditWallet @relation(fields: [walletId], references: [id])
}

model CashfreePendingOrder {
  id               String    @id @default(cuid())
  orderId          String    @unique
  feeRecordId      String
  parentId         String
  studentId        String
  amount           Float
  paymentSessionId String
  status           String    @default("CREATED")
  paymentMethod    String?
  transactionId    String?
  failureReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  feeRecord        FeeRecord @relation(fields: [feeRecordId], references: [id])

  @@index([orderId])
  @@index([feeRecordId])
  @@index([status])
}

model DisciplineReport {
  id             String      @id @default(cuid())
  studentId      String
  reportedBy     String
  category       String
  description    String
  status         String      @default("PENDING")
  adminNote      String?
  reviewedBy     String?
  reviewedAt     DateTime?
  actionTaken    String?
  actionType     ActionType?
  suspendedFrom  DateTime?
  suspendedUntil DateTime?
  warningNote    String?
  resolvedAt     DateTime?
  fineAmount     Float?
  fineReason     String?
  fineStatus     FineStatus? @default(PENDING)
  fineDueDate    DateTime?
  finePaidAt     DateTime?
  finePaidAmount Float?
  feeRecordId    String?     @unique

  createdAt      DateTime    @default(now())
  teacher        Teacher     @relation(fields: [reportedBy], references: [id])
  student        Student     @relation(fields: [studentId], references: [id])

  @@index([status])
  @@index([studentId])
  @@index([reportedBy])
}

model Notice {
  id            String         @id @default(cuid())
  title         String
  content       String         @db.Text
  category      NoticeCategory
  priority      NoticePriority @default(NORMAL)
  targetAudience NoticeTarget
  targetClassId String?
  createdById   String
  createdByRole String
  isPinned      Boolean        @default(false)
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Kept for migration backwards compatibility without data loss prompt
  audience      String[]
  postedBy      String?
  isActive      Boolean?       @default(true)

  createdBy     User           @relation(fields: [createdById], references: [id])
  targetClass   Class?         @relation(fields: [targetClassId], references: [id])

  @@index([targetAudience])
  @@index([targetClassId])
  @@index([createdById])
}

model Leave {
  id         String   @id @default(cuid())
  userId     String
  type       String
  fromDate   DateTime
  toDate     DateTime
  reason     String
  status     String   @default("PENDING")
  approvedBy String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model TimetablePeriod {
  id           String   @id @default(cuid())
  teacherId    String
  classId      String
  subjectId    String
  dayOfWeek    Int
  periodNumber Int
  startTime    String
  endTime      String
  roomNumber   String
  createdAt    DateTime @default(now())
  class        Class    @relation(fields: [classId], references: [id])
  subject      Subject  @relation(fields: [subjectId], references: [id])
  teacher      Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, dayOfWeek, periodNumber])
  @@index([teacherId])
  @@index([classId])
}

model SystemSettings {
  id                 String   @id @default("singleton")
  schoolName         String
  schoolEmail        String
  schoolPhone        String?
  schoolAddress      String?
  minimumAttendance  Int      @default(75)
  detentionThreshold Int      @default(75)
  gradingSystem      String   @default("PERCENTAGE")
  enableEmailAlerts  Boolean  @default(true)
  enableSMSAlerts    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FeeType {
  id           String  @id @default(cuid())
  name         String
  amount       Float
  frequency    String
  applicableTo String  @default("ALL")
  description  String?
  isActive     Boolean @default(true)
}

model Exam {
  id             String        @id @default(cuid())
  name           String
  type           ExamType
  academicYear   String
  status         ExamStatus    @default(DRAFT)
  startDate      DateTime
  endDate        DateTime
  defaultPassPct Float         @default(33)
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  results        ExamResult[]
  slots          ExamSlot[]
  summaries      ExamSummary[]
  hallTickets    HallTicket[]
}

model ExamSlot {
  id        String       @id @default(cuid())
  examId    String
  classId   String
  subjectId String
  date      DateTime     @db.Date
  startTime String
  endTime   String
  room      String
  maxMarks  Float
  passMarks Float        @default(33)
  isLocked  Boolean      @default(false)
  results   ExamResult[]
  class     Class        @relation(fields: [classId], references: [id])
  exam      Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id])

  @@unique([examId, classId, subjectId])
  @@unique([classId, date, startTime])
}

model ExamResult {
  id        String   @id @default(cuid())
  examId    String
  slotId    String
  studentId String
  marks     Float?
  isAbsent  Boolean  @default(false)
  grade     String?
  remarks   String?
  enteredBy String
  enteredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exam      Exam     @relation(fields: [examId], references: [id])
  slot      ExamSlot @relation(fields: [slotId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([slotId, studentId])
  @@index([examId, studentId])
  @@index([slotId])
}

model ExamSummary {
  id          String   @id @default(cuid())
  examId      String
  studentId   String
  totalMarks  Float    @default(0)
  maxMarks    Float    @default(0)
  percentage  Float    @default(0)
  grade       String   @default("")
  rank        Int?
  isPassed    Boolean  @default(false)
  isPublished Boolean  @default(false)
  computedAt  DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
}

model HallTicket {
  id          String   @id @default(cuid())
  examId      String
  studentId   String
  isBlocked   Boolean  @default(false)
  blockReason String?
  blockedBy   String?
  generatedAt DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
}

model MessageConversation {
  id           String               @id @default(cuid())
  type         ConversationType
  name         String?
  classId      String?
  createdById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  messages     Message[]
  createdBy    User                 @relation("CreatedConversations", fields: [createdById], references: [id])
  participants MessageParticipant[]

  @@index([updatedAt(sort: Desc)])
}

model MessageParticipant {
  id             String              @id @default(cuid())
  conversationId String
  userId         String
  role           ParticipantRole     @default(MEMBER)
  joinedAt       DateTime            @default(now())
  lastReadAt     DateTime?
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  messageType    MessageType         @default(TEXT)
  isDeleted      Boolean             @default(false)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation("SentMessages", fields: [senderId], references: [id])
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  fileUrl   String  @db.VarChar(500)
  fileName  String  @db.VarChar(255)
  fileType  String  @db.VarChar(100)
  fileSize  Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  BLOCKED
}

enum ActionType {
  WARNING
  SUSPENSION
  DISMISSED
  FINE_ONLY
  WARNING_WITH_FINE
  SUSPENDED_WITH_FINE
}

enum FineStatus {
  PENDING
  PAID
  WAIVED
  PARTIAL
  OVERDUE
}

enum NotificationType {
  DISCIPLINE
  ATTENDANCE
  FEE
  ACADEMIC
  SYSTEM
  NOTICE
}

enum NoticeCategory {
  GENERAL
  ACADEMIC
  EVENT
  URGENT
  FEE_RELATED
  HOLIDAY
}

enum NoticePriority {
  NORMAL
  HIGH
  URGENT
}

enum NoticeTarget {
  ALL_STUDENTS
  ALL_TEACHERS
  ALL_PARENTS
  SPECIFIC_CLASS
  EVERYONE
}

enum ExamType {
  UNIT_TEST_1
  UNIT_TEST_2
  MID_TERM
  PRE_BOARD
  FINAL
  PRACTICAL
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ONGOING
  MARKS_ENTRY
  COMPLETED
}

enum ConversationType {
  DIRECT
  GROUP
  ANNOUNCEMENT
}

enum ParticipantRole {
  MEMBER
  ADMIN
}

enum MessageType {
  TEXT
  SYSTEM
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  role          String      // 'user', 'assistant', 'system', 'tool'
  content       String      @db.Text
  toolCalls     Json?       // Store tool execution data
  createdAt     DateTime    @default(now())
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AITokenUsage {
  id           String      @id @default(cuid())
  userId       String
  sessionId    String?
  promptTokens Int
  completionTokens Int
  totalTokens  Int
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
}
